# ============================================================
#  PLANTILLA DE VARIABLES DE ENTORNO — copiar como .env
#  NUNCA subir el archivo .env al repositorio
# ============================================================

# ── Base de datos ────────────────────────────────────────────
POSTGRES_USER=fichaje_user
POSTGRES_PASSWORD=CambiaEstaPorUnaSegura_2025
POSTGRES_DB=gestion_fichajes
DATABASE_URL=postgresql://fichaje_user:CambiaEstaPorUnaSegura_2025@db:5432/gestion_fichajes

# ── Seguridad JWT ────────────────────────────────────────────
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambia_esto_por_clave_aleatoria_muy_larga_minimo_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Protección contra fuerza bruta ──────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ── Administrador inicial ────────────────────────────────────
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=AdminSeguro_2025!
ADMIN_NOMBRE=Administrador

# ── FTPS ─────────────────────────────────────────────────────
FTP_HOST=asir_ftps
FTP_USER_NAME=ftpuser
FTP_USER_PASS=FtpSeguro_2025!

# ── Frontend ─────────────────────────────────────────────────
API_URL=http://backend:8000
API_URL_PUBLICA=http://localhost:8000

# ── Geofencing (coordenadas del centro de trabajo) ───────────
GEOFENCE_LAT=36.6850
GEOFENCE_LON=-6.1261
GEOFENCE_RADIUS_METERS=300

# ── Datos de prueba ──────────────────────────────────────────
# true  → crea usuarios/fichajes de ejemplo al arrancar (desarrollo)
# false → no toca la base de datos (producción)
SEED_DATA=true

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
